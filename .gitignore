# Go build output and development tooling
/build/
.env
!.env.example
/deploy/.env
bin/
tmp/
coverage.out
*.test

# Editor and operating-system files
.idea/
.vscode/
.kilo/
.DS_Store
Thumbs.db

# Legacy JavaScript artifacts
node_modules/
dist/
*.tsbuildinfo

# Client runtime state (created beside executable during development)
# Старое расположение артефактов: новые цели Makefile его не используют.
apps/mc-build-updater/build/
apps/mc-build-updater/tmp/
apps/mc-build-updater/mods/
apps/mc-build-updater/mc-mods-updater.config.yml
apps/mc-build-updater/mc-mods-updater.log
apps/mc-build-updater/mm.json
apps/mc-build-updater/mc-build-updater.exe.new
apps/mc-build-updater/mc-build-updater.updater.exe
apps/mc-build-updater/release/

# Runtime SQLite map of file-hosting.
apps/file-hosting/files/.file-hosting.sqlite*

# Локальные моды и манифесты в file-hosting не должны попадать в production deploy.
apps/file-hosting/files/MM/*
!apps/file-hosting/files/MM/.gitkeep
apps/file-hosting/files/mods/

# Исполняемые файлы и архивы release не попадают в репозиторий.
*.exe
*.7z
