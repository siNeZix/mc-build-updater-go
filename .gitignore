# Go build output and development tooling
bin/
tmp/
coverage.out
*.test

# Editor and operating-system files
.idea/
.vscode/
.kilo/
.DS_Store
Thumbs.db

# Legacy JavaScript artifacts
node_modules/
dist/
*.tsbuildinfo

# Client runtime state (created beside executable during development)
apps/mc-build-updater/build/
apps/mc-build-updater/tmp/
apps/mc-build-updater/mods/
apps/mc-build-updater/mc-mods-updater.config.yml
apps/mc-build-updater/mc-mods-updater.log
apps/mc-build-updater/mm.json
apps/mc-build-updater/7z.exe
apps/mc-build-updater/update.exe
apps/mc-build-updater/mc-build-updater.7z
apps/mc-build-updater/mods.7z

# Keep distributable files served by file-hosting under version control.
*.exe
!apps/file-hosting/files/**/*.exe
*.7z
!apps/file-hosting/files/**/*.7z
