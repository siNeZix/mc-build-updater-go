# rclone remote и путь к каталогу проекта на сервере.
DEPLOY_RCLONE_REMOTE=production
DEPLOY_REMOTE_PATH=/opt/mc-build-updater

# SSH нужен для запуска Docker Compose после rclone sync.
DEPLOY_SSH_TARGET=user@example.com
DEPLOY_SSH_PORT=22
# Необязательно: если ключ уже выбран ssh-agent/config, оставь пустым.
DEPLOY_SSH_KEY=

# Go module proxy used only while the production image is built. The default
# is proxy.golang.org,direct; set https://goproxy.cn if that host is unreachable.
DEPLOY_GOPROXY=https://proxy.golang.org,direct

# Токен передаётся в production Compose через удалённый deploy/.env.
FILE_HOSTING_TOKEN=change-me
